# StableBridge Indexer — Environment Variables
# Copy to .env and fill in your values: cp .env.example .env

# ---------------------------------------------------------------------------
# API Authentication
# ---------------------------------------------------------------------------
INDEXER_API_KEY=change-me

# ---------------------------------------------------------------------------
# Infrastructure (defaults match docker-compose.yml)
# ---------------------------------------------------------------------------
DB_USERNAME=indexer
DB_PASSWORD=indexer
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# ---------------------------------------------------------------------------
# Mainnet RPC URLs (required for production)
# ---------------------------------------------------------------------------
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
BITCOIN_RPC_URL=http://localhost:8332
BITCOIN_RPC_USERNAME=bitcoin
BITCOIN_RPC_PASSWORD=bitcoin

# ---------------------------------------------------------------------------
# Testnet RPC URLs (required for --spring.profiles.active=testnet)
# ---------------------------------------------------------------------------
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
BITCOIN_TESTNET_RPC_URL=http://localhost:18332
