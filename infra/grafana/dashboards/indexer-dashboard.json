        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
      "id": 21,
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
